# ================= 数据库（二选一） =================
# 【本地】先安装 MongoDB Community Server，保持下面默认值即可
#   winget install MongoDB.Server
#   MONGO_URI=mongodb://localhost:27017
#
# 【云端】MongoDB Atlas 免费集群，注册地址 https://www.mongodb.com/cloud/atlas
#   格式：mongodb+srv://<用户名>:<密码>@<集群名>.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   注意：<password> 换成真实密码；密码含 @ # % / 等字符需 URL 编码；
#         Atlas 左侧 Network Access 需放行你的 IP。
MONGO_URI=mongodb://localhost:27017
DB_NAME=niangao

# 【可选】DNS 解析器
# mongodb+srv:// 需要查询 SRV 记录，部分家用路由器不转发这类查询，
# 报错形如 "The DNS operation timed out" 或 NXDOMAIN。
# 若本地遇到该问题，填一个公共 DNS 即可绕开；云端部署留空（不启用）。
# DNS_RESOLVERS=223.5.5.5

# ================= 鉴权密钥 =================
# 用 python -c "import secrets;print(secrets.token_hex(32))" 生成，两串必须不同
JWT_SECRET=请替换为随机字符串
JWT_REFRESH_SECRET=请替换为另一串随机字符串

# ================= 部署 =================
# 【可选】线上前端域名，多个用英文逗号分隔。
# 本地开发不用填，localhost 已经内置在允许列表里。
# 例：CORS_ORIGINS=https://niangao-ai.vercel.app
# CORS_ORIGINS=

# ================= 大模型 =================
# 本项目用 OpenAI 兼容协议，以下三种任选其一填写：
#
# 【方案一】豆包 / 火山方舟
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=你在方舟控制台创建的推理接入点 ID（形如 ep-2024xxxx）
#
# 【方案二】DeepSeek（最省事，注册即用）
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# 【方案三】通义千问 / 阿里云百炼
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
